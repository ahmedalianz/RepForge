{
  "name": "repforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --resolve-plugins-relative-to node_modules/@react-native/eslint-config --max-warnings=0",
    "start": "react-native start",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "test:domain": "jest --selectProjects domain --runInBand",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pods": "bundle exec pod install --project-directory=ios"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.18.8",
    "i18next": "26.5.10",
    "react": "19.3.0",
    "react-i18next": "17.1.8",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.4.0",
    "react-native-localize": "3.7.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-sqlite": "10.2.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "eslint": "8.57.1",
    "jest": "^29.6.3",
    "prettier": "3.9.10",
    "test-renderer": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "packageManager": "npm@11.16.0"
}
